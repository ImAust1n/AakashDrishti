# DepthWizard backend configuration.
# Copy to .env and fill in local paths. Never commit the real .env.

# --- Model weights (local paths; see model/ for vendored source) ---
DEPTH_ANYTHING_V2_ENCODER=vitb
DEPTH_ANYTHING_V2_CHECKPOINT=./model/depth_anything_v2_vitb.pth
DEPTH_PRO_CHECKPOINT=./model/ml-depth-pro-main/checkpoints/depth_pro.pt

# --- Device / precision ---
# cuda | cpu
DEVICE=cuda
# DA V2 has no fp16 issues observed; Depth Pro is run at fp16 on CUDA.
DEPTH_PRO_PRECISION=float16

# --- Reference elevation data (for GeoTIFF calibration) ---
# Directory containing SRTM 30m (or other DEM) tiles usable for calibration.
SRTM_DATA_DIR=./data/reference

# --- Storage ---
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# --- API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (the Next.js dev server by default).
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
